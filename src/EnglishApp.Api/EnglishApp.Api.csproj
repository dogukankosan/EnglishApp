<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\EnglishApp.Shared\EnglishApp.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.MSSqlServer" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kokoro ile üretilen hazır sesler (tools/audiogen) yayına da kopyalansın -->
    <Content Include="Content\audio\**\*.mp3" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <!-- Yerel gizli ayarlar (ve örnekleri) yayın paketine girmez -->
    <Content Update="appsettings.Development*.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
