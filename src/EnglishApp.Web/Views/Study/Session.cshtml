@{
    ViewData["Title"] = "Çalışma";
}
<div class="study-wrap" id="studyApp" data-scenario-id="@(ViewBag.ScenarioId)">
    <div class="study-top">
        <a href="/Study" class="btn btn-icon" title="Çık"><i class="bi bi-x-lg"></i></a>
        <div class="progress"><div class="progress-bar" id="progressBar" style="width:0%"></div></div>
        <span class="small fw-semibold text-body-secondary" id="progressText">0/0</span>
    </div>
    <div class="d-flex justify-content-end mb-2" id="audioPrefs"></div>
    <div class="d-flex justify-content-between small text-body-secondary mb-2 px-1">
        <span id="scenarioName"></span>
        <span><span class="badge bg-primary-soft text-primary" id="cntNew">0 yeni</span> <span class="badge bg-success-subtle text-success" id="cntReview">0 tekrar</span></span>
    </div>

    <div id="stage">
        <div class="card flashcard"><div class="card-body"><div class="skeleton mx-auto" style="width:60%;height:3rem"></div></div></div>
    </div>

    <div id="actions" class="mt-3"></div>
    <div class="text-center kbd-hint mt-3 d-none d-md-block">
        <kbd>Boşluk</kbd> cevabı göster · <kbd>1</kbd>-<kbd>4</kbd> puan ver · <kbd>R</kbd> tekrar dinle
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/session.js" asp-append-version="true"></script>
}
