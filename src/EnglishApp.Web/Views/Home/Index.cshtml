@{
    ViewData["Title"] = "Durumum";
    var firstName = (User.Identity?.Name ?? "").Split(' ').FirstOrDefault();
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h1 class="h3 page-title">Merhaba @firstName 👋</h1>
        <p class="page-subtitle mb-0" id="greetingText">Bugün ne kadar ilerlediğine bakalım.</p>
    </div>
</div>

<div id="placementBanner" class="alert alert-info d-none d-flex align-items-center gap-3 border-0" style="border-radius:14px">
    <i class="bi bi-clipboard-check fs-3"></i>
    <div class="flex-grow-1">
        <div class="fw-semibold">Önce seviye testini yap</div>
        <div class="small">Bildiğin kelimeleri işaretle, uygulama onları sana tekrar sormasın. 2 dakika sürer.</div>
    </div>
    <a href="/Placement" class="btn btn-primary btn-sm">Teste başla</a>
</div>

<div id="listeningBanner" class="alert alert-warning d-none d-flex align-items-center gap-3 border-0" style="border-radius:14px">
    <i class="bi bi-ear fs-3"></i>
    <div class="flex-grow-1">
        <div class="fw-semibold">Aylık dinleme ölçümü zamanı</div>
        <div class="small" id="listeningBannerText">Bir dinleme testi çöz, anlama seviyendeki gelişimi gör. 3 dakika sürer.</div>
    </div>
    <a href="/Practice/Listen" class="btn btn-warning btn-sm">Teste git</a>
</div>

<div class="card hero-card mb-4">
    <div class="card-body p-4 d-flex flex-column flex-md-row align-items-md-center gap-3">
        <div class="flex-grow-1">
            <div class="text-soft small fw-semibold text-uppercase mb-1">Bugünkü çalışma</div>
            <div class="h3 fw-bold mb-1" id="heroTitle">Yükleniyor…</div>
            <div class="text-soft" id="heroText"></div>
        </div>
        <a href="/Study/Session" class="btn btn-light btn-lg px-4" id="heroBtn"><i class="bi bi-play-fill me-1"></i>Çalışmaya başla</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card stat-card">
            <span class="stat-icon icon-indigo"><i class="bi bi-mortarboard"></i></span>
            <div class="stat-value" id="statLevel">-</div>
            <div class="stat-label">Tahmini seviye</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card">
            <span class="stat-icon icon-orange"><i class="bi bi-fire"></i></span>
            <div class="stat-value" id="statStreak">-</div>
            <div class="stat-label">Günlük seri <span class="small" id="statBest"></span></div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card">
            <span class="stat-icon icon-green"><i class="bi bi-check2-circle"></i></span>
            <div class="stat-value" id="statToday">-</div>
            <div class="stat-label">Bugün çalışılan kart</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card">
            <span class="stat-icon icon-pink"><i class="bi bi-bullseye"></i></span>
            <div class="stat-value" id="statAccuracy">-</div>
            <div class="stat-label">Bu hafta doğruluk</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center"><span><i class="bi bi-flag me-2"></i>Hedefim</span><a href="/Profile" class="small">Düzenle</a></div>
            <div class="card-body" id="goalBox"><div class="skeleton" style="height:90px"></div></div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-compass me-2"></i>Haftalık koç</span>
                <button class="btn btn-sm btn-outline-primary" id="coachBtn"><i class="bi bi-magic me-1"></i>Raporu hazırla</button>
            </div>
            <div class="card-body" id="coachBox"><div class="skeleton" style="height:90px"></div></div>
        </div>
    </div>
</div>
<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Son 30 gün</span>
                <span class="small text-body-secondary" id="weekSummary"></span>
            </div>
            <div class="card-body"><div style="height:240px"><canvas id="chart30"></canvas></div></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">Kelimelerim</div>
            <div class="card-body">
                <a href="/Words?filter=Learned" class="d-flex justify-content-between align-items-center text-decoration-none text-body py-2 border-bottom">
                    <span><i class="bi bi-patch-check text-success me-2"></i>Öğrendiklerim</span><b id="cntLearned">-</b>
                </a>
                <a href="/Words?filter=Learning" class="d-flex justify-content-between align-items-center text-decoration-none text-body py-2 border-bottom">
                    <span><i class="bi bi-hourglass-split text-primary me-2"></i>Öğreniyorum</span><b id="cntLearning">-</b>
                </a>
                <a href="/Words?filter=Struggling" class="d-flex justify-content-between align-items-center text-decoration-none text-body py-2 border-bottom">
                    <span><i class="bi bi-exclamation-triangle text-danger me-2"></i>Zorlandıklarım</span><b id="cntStruggling">-</b>
                </a>
                <a href="/Words?filter=Known" class="d-flex justify-content-between align-items-center text-decoration-none text-body py-2 border-bottom">
                    <span><i class="bi bi-star text-warning me-2"></i>Zaten biliyorum</span><b id="cntKnown">-</b>
                </a>
                <a href="/Practice/Listen" class="d-flex justify-content-between align-items-center text-decoration-none text-body py-2">
                    <span><i class="bi bi-ear text-danger me-2"></i>Dinleme anlama (30 gün)</span><b id="listenScore">-</b>
                </a>
                <div class="small text-body-secondary mt-3" id="levelNote"></div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Çalışma takvimi (son 6 ay)</span>
        <span class="small text-body-secondary d-none d-sm-inline">Az <span class="heatmap d-inline-grid" style="grid-template-rows:1fr"><span class="day"></span><span class="day l1"></span><span class="day l2"></span><span class="day l3"></span><span class="day l4"></span></span> Çok</span>
    </div>
    <div class="card-body"><div class="heatmap" id="heatmap"></div></div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Senaryo ilerlemesi</span>
        <a href="/Study" class="small">Tümü</a>
    </div>
    <div class="card-body" id="scenarioProgress"><div class="skeleton" style="height:80px"></div></div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.js"></script>
    <script src="~/js/pages/dashboard.js" asp-append-version="true"></script>
}
