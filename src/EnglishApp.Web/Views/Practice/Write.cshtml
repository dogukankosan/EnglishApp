@{
    ViewData["Title"] = "Yazma Çalışması";
}
<div style="max-width:900px" class="mx-auto" id="writeApp" data-writing-id="@(ViewBag.WritingId)">
    <div class="mb-3"><a href="/Practice" class="small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>AI Pratik</a></div>
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div>
            <h1 class="h3 page-title">Yazma çalışması</h1>
            <p class="page-subtitle mb-0">Bir görev seç ve İngilizce yaz. Mükemmel olması gerekmiyor, hatalar öğrenmenin parçası.</p>
        </div>
        <span class="badge bg-primary-soft text-primary px-3 py-2" id="quotaBadge"></span>
    </div>

    <div id="editor">
        <div class="card mb-3">
            <div class="card-header">1. Görev seç</div>
            <div class="card-body">
                <div class="row g-2" id="tasks"></div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>2. Yaz</span>
                <span class="small text-body-secondary"><span id="wordCount">0</span> kelime <span id="minWords"></span></span>
            </div>
            <div class="card-body">
                <div class="alert alert-light border small" id="taskInfo">Yukarıdan bir görev seç veya serbest yaz.</div>
                <input class="form-control mb-2 d-none" id="freeTopic" maxlength="300" placeholder="Ne hakkında yazıyorsun? (isteğe bağlı, Türkçe olabilir)" />
                <textarea class="form-control" id="text" rows="9" maxlength="2000" lang="en" spellcheck="false"
                          placeholder="Write here in English…"></textarea>
                <div class="form-text">Tarayıcının yazım denetimi kapalı: hataları AI'ın yakalaması için. En fazla 2000 karakter.</div>
            </div>
        </div>

        <div class="d-flex justify-content-end">
            <button class="btn btn-primary btn-lg" id="submitBtn"><i class="bi bi-magic me-1"></i>Değerlendir</button>
        </div>
    </div>

    <div id="result" class="d-none"></div>
</div>

@section Scripts {
    <script src="~/js/pages/write.js" asp-append-version="true"></script>
}
