@{
    ViewData["Title"] = "AI Pratik";
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h1 class="h3 page-title">AI Pratik</h1>
        <p class="page-subtitle mb-0">Konuş, yaz, dinle, oku: yapay zeka her adımda yanında.</p>
    </div>
    <span class="badge bg-primary-soft text-primary px-3 py-2" id="quotaBadge"><i class="bi bi-cpu me-1"></i>…</span>
</div>

<div id="notConfigured" class="alert alert-warning d-none border-0" style="border-radius:14px">
    <i class="bi bi-exclamation-triangle me-1"></i> Yapay zeka henüz ayarlanmamış. Yönetici, <b>Yönetim &gt; Ayarlar</b> ekranından Gemini API anahtarını girmeli.
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body p-4">
                <span class="stat-icon icon-indigo mb-3"><i class="bi bi-mic"></i></span>
                <h2 class="h5 fw-bold">Sesli rol yapma</h2>
                <p class="text-body-secondary small">Bir senaryo seç: AI resepsiyonist, garson, taksici olsun; sen müşteri. Konuş veya yaz, her cümlende anında düzeltme al.</p>
                <div class="input-group mb-2">
                    <select class="form-select" id="scenarioSelect"><option value="">Senaryo seç…</option></select>
                    <button class="btn btn-primary" id="startRolePlay"><i class="bi bi-play-fill me-1"></i>Başla</button>
                </div>
                <button class="btn btn-outline-primary w-100" id="startFree"><i class="bi bi-cup-hot me-1"></i>Serbest sohbet (arkadaşınla konuşur gibi)</button>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body p-4">
                <span class="stat-icon icon-green mb-3"><i class="bi bi-pencil-square"></i></span>
                <h2 class="h5 fw-bold">Yazma çalışması</h2>
                <p class="text-body-secondary small">Otele mail, restoran yorumu, kendini tanıtma… Yaz; AI hatalarını Türkçe açıklasın, doğal halini göstersin, puan versin.</p>
                <a href="/Practice/Write" class="btn btn-primary w-100"><i class="bi bi-pencil me-1"></i>Yazmaya başla</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <a href="/Practice/Listen" class="card h-100 text-decoration-none text-body scenario-card">
            <div class="card-body">
                <span class="stat-icon icon-pink"><i class="bi bi-ear"></i></span>
                <div class="fw-bold">Dinleme testi</div>
                <div class="small text-body-secondary">Diyaloğu metinsiz dinle, soruları cevapla. Ayda bir seviyeni ölç.</div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="/Practice/Capture" class="card h-100 text-decoration-none text-body scenario-card">
            <div class="card-body">
                <span class="stat-icon icon-orange"><i class="bi bi-bookmark-plus"></i></span>
                <div class="fw-bold">Cümle yakala</div>
                <div class="small text-body-secondary">Dizide, YouTube'da duyduğun cümleyi yapıştır, AI açıklasın, kartlarına ekle.</div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="/Practice/Travel" class="card h-100 text-decoration-none text-body scenario-card">
            <div class="card-body">
                <span class="stat-icon icon-green"><i class="bi bi-suitcase"></i></span>
                <div class="fw-bold">Seyahat kiti</div>
                <div class="small text-body-secondary">Gideceğin yere özel en gerekli kalıplar ve yerel ipuçları.</div>
            </div>
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <a href="/Practice/Dictation" class="card h-100 text-decoration-none text-body scenario-card">
            <div class="card-body">
                <span class="stat-icon icon-indigo"><i class="bi bi-keyboard"></i></span>
                <div class="fw-bold">Dikte</div>
                <div class="small text-body-secondary">Dinle, duyduğunu yaz. Bağlı konuşmayı (gonna, wanna) çözmeyi öğren.</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a href="/Practice/Reading" class="card h-100 text-decoration-none text-body scenario-card">
            <div class="card-body">
                <span class="stat-icon icon-green"><i class="bi bi-book"></i></span>
                <div class="fw-bold">Okuma</div>
                <div class="small text-body-secondary">Bildiğin kelimelerle sana özel hikâye; dokun, çevir, kartına ekle.</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a href="/Practice/Video" class="card h-100 text-decoration-none text-body scenario-card">
            <div class="card-body">
                <span class="stat-icon icon-red"><i class="bi bi-youtube"></i></span>
                <div class="fw-bold">YouTube sahneleri</div>
                <div class="small text-body-secondary">Videoyu cümle cümle izle, tekrar dinle, beğendiğini yakala.</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a href="/Practice/Media" class="card h-100 text-decoration-none text-body scenario-card">
            <div class="card-body">
                <span class="stat-icon icon-orange"><i class="bi bi-camera-reels"></i></span>
                <div class="fw-bold">Ne izlesem?</div>
                <div class="small text-body-secondary">Seviyene uygun dizi, kanal ve podcast önerileri.</div>
            </div>
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Son konuşmalar</div>
            <div class="list-group list-group-flush" id="convList"><div class="p-3"><div class="skeleton" style="height:60px"></div></div></div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Son yazılar</div>
            <div class="list-group list-group-flush" id="writeList"><div class="p-3"><div class="skeleton" style="height:60px"></div></div></div>
        </div>
    </div>
</div>
<p class="small text-body-secondary mt-3"><i class="bi bi-info-circle me-1"></i>Konuşma ve yazıların, değerlendirme için yapay zeka sağlayıcısına (Google Gemini) gönderilir. Ücretsiz katmanda Google bu verileri modellerini geliştirmek için kullanabilir; kişisel bilgi yazma.</p>

@section Scripts {
    <script>
        (async function () {
            const { api, esc, fmt } = App;

            const [quota, scenarios, convs, writings] = await Promise.all([
                api.get('ai/quota').catch(() => null),
                api.get('scenarios').catch(() => []),
                api.get('ai/conversations').catch(() => []),
                api.get('ai/writing').catch(() => [])
            ]);

            if (quota) {
                $('#quotaBadge').html(`<i class="bi bi-cpu me-1"></i>Bugün: ${fmt.number(quota.used)} / ${quota.limit == null ? '∞' : fmt.number(quota.limit)} token`);
                if (!quota.isConfigured) $('#notConfigured').removeClass('d-none');
            }

            $('#scenarioSelect').append(scenarios.map(s => `<option value="${s.id}">${esc(s.titleTr)} (${esc(s.level)})</option>`).join(''));
            const pre = new URLSearchParams(location.search).get('scenarioId');
            if (pre) $('#scenarioSelect').val(pre);

            $('#startRolePlay').on('click', () => {
                const id = $('#scenarioSelect').val();
                if (!id) return App.toast('Önce bir senaryo seç', 'info');
                location.href = '/Practice/Talk?scenarioId=' + id;
            });
            $('#startFree').on('click', () => location.href = '/Practice/Talk?mode=free');

            $('#convList').html(convs.length ? convs.slice(0, 8).map(c => `
                <a href="/Practice/Talk/${c.id}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                    <div>
                        <div class="fw-semibold">${esc(c.title || 'Konuşma')}</div>
                        <div class="small text-body-secondary">${fmt.dateTime(c.startedAt)} · ${c.userMessageCount} mesaj</div>
                    </div>
                    ${c.endedAt ? '<span class="badge bg-success-subtle text-success">Bitti</span>' : '<span class="badge bg-primary-soft text-primary">Devam et</span>'}
                </a>`).join('') : '<div class="empty-state py-4"><i class="bi bi-chat"></i>Henüz konuşma yok.</div>');

            $('#writeList').html(writings.length ? writings.slice(0, 8).map(w => `
                <a href="/Practice/Write/${w.id}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                    <div class="me-2 min-w-0">
                        <div class="fw-semibold text-truncate">${esc(w.preview)}</div>
                        <div class="small text-body-secondary">${fmt.dateTime(w.createdAt)}</div>
                    </div>
                    <div class="text-end text-nowrap"><div class="fw-bold">${w.score ?? '-'}</div><span class="level-badge">${esc(w.estimatedLevel || '')}</span></div>
                </a>`).join('') : '<div class="empty-state py-4"><i class="bi bi-pencil"></i>Henüz yazı yok.</div>');
        })();
    </script>
}
