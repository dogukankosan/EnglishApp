@{
    ViewData["Title"] = "Okuma";
}
<div style="max-width:820px" class="mx-auto" id="readApp" data-reading-id="@(ViewBag.ReadingId)">
    <div class="mb-3"><a href="/Practice" class="small text-decoration-none" id="backLink"><i class="bi bi-arrow-left me-1"></i>AI Pratik</a></div>

    <div id="createView" class="d-none">
        <h1 class="h3 page-title">Okuma</h1>
        <p class="page-subtitle">AI, bildiğin kelimelerle sana özel kısa bir hikâye yazar; içine en fazla 8 yeni kelime koyar. Bilmediğin kelimeye dokun, anlamını gör, kartlarına ekle.</p>
        <div class="card mb-4">
            <div class="card-body">
                <form id="readForm" class="row g-2 align-items-end">
                    <div class="col-md-7"><label class="form-label small fw-semibold">Konu (isteğe bağlı)</label><input class="form-control" id="rTopic" maxlength="150" placeholder="Ör: Londra'da ilk iş günü, kafede yanlış sipariş" /></div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Seviye</label>
                        <select class="form-select" id="rLevel"><option value="">Otomatik</option><option>A1</option><option>A2</option><option>B1</option><option>B2</option><option>C1</option></select>
                    </div>
                    <div class="col-md-2 d-grid"><button class="btn btn-primary" id="createBtn" type="submit"><i class="bi bi-magic me-1"></i>Yaz</button></div>
                </form>
            </div>
        </div>
        <div class="card">
            <div class="card-header"><i class="bi bi-book me-2"></i>Metinlerim</div>
            <div class="list-group list-group-flush" id="readList"><div class="p-3"><div class="skeleton" style="height:60px"></div></div></div>
        </div>
    </div>

    <div id="readView" class="d-none"></div>
    <div id="lookupPop" class="lookup-pop d-none"></div>
</div>

@section Scripts {
    <script>
        (async function () {
            const { api, esc, fmt, posNames } = App;
            const readingId = $('#readApp').data('reading-id') || null;

            if (readingId) return showReading(readingId);
            $('#createView').removeClass('d-none');
            loadList();

            async function loadList() {
                try {
                    const list = await api.get('reading');
                    $('#readList').html(list.length ? list.map(r => `
                        <a href="/Practice/Reading/${r.id}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                            <div class="me-2 min-w-0"><div class="fw-semibold text-truncate" lang="en">${esc(r.title)}</div>
                                <div class="small text-body-secondary">${r.topic ? esc(r.topic) + ' · ' : ''}${r.wordCount} kelime · ${fmt.date(r.createdAt)}</div></div>
                            <div class="text-nowrap"><span class="level-badge">${esc(r.level)}</span> ${r.readAt ? '<i class="bi bi-check2-circle text-success ms-1" title="Okundu"></i>' : ''}</div>
                        </a>`).join('') : '<div class="empty-state py-4"><i class="bi bi-book"></i>Henüz metin yok. İlkini yazdır!</div>');
                } catch (e) { App.showError(e); }
            }

            $('#readForm').on('submit', async function (e) {
                e.preventDefault();
                App.busy('#createBtn', true, 'Yazılıyor');
                try {
                    const r = await api.post('reading', { topic: $('#rTopic').val().trim() || null, level: $('#rLevel').val() || null });
                    location.href = '/Practice/Reading/' + r.id;
                } catch (err) { App.showError(err); App.busy('#createBtn', false); }
            });

            // ---------- Metin ----------
            async function showReading(id) {
                $('#backLink').attr('href', '/Practice/Reading').html('<i class="bi bi-arrow-left me-1"></i>Metinlerim');
                $('#readView').removeClass('d-none').html('<div class="skeleton" style="height:320px"></div>');
                let r;
                try { r = await api.get('reading/' + id); } catch (e) { return App.showError(e); }
                document.title = r.title + ' · EnglishApp';
                const c = r.content;
                const gloss = {};
                c.glossary.forEach(g => gloss[g.word.toLowerCase()] = g);

                const wordify = text => text.split(/(?<=[.!?])\s+/).map(s =>
                    `<span class="rs">${s.split(/([A-Za-z][A-Za-z'’-]*)/).map((part, i) => i % 2
                        ? `<span class="rw${gloss[part.toLowerCase()] ? ' new' : ''}">${esc(part)}</span>` : esc(part)).join('')}</span>`).join(' ');

                $('#readView').html(`
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                        <div><h1 class="h3 page-title mb-0" lang="en">${esc(r.title)}</h1>
                            <div class="small text-body-secondary"><span class="level-badge">${esc(r.level)}</span> ${r.wordCount} kelime · ${c.glossary.length} yeni kelime</div></div>
                        <div class="d-flex gap-2 align-items-center">
                            <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" id="showTr"><label class="form-check-label small" for="showTr">Türkçesi</label></div>
                            <button class="btn btn-outline-danger btn-sm" id="delRead" title="Sil"><i class="bi bi-trash"></i></button>
                        </div>
                    </div>
                    <div class="alert bg-primary-soft border-0 small" style="border-radius:12px"><i class="bi bi-hand-index me-1"></i>Bilmediğin kelimeye dokun. <span style="border-bottom:2px dotted var(--app-primary)">Altı noktalı</span> kelimeler yeni.</div>
                    <div class="card mb-3"><div class="card-body reading-text" lang="en">
                        ${c.paragraphs.map((p, i) => `
                            <div class="d-flex gap-2 align-items-start">
                                <button class="btn btn-sm btn-icon say-p flex-shrink-0" data-i="${i}" title="Paragrafı dinle"><i class="bi bi-volume-up"></i></button>
                                <div class="flex-grow-1"><p>${wordify(p.en)}</p><div class="reading-tr d-none" lang="tr">${esc(p.tr)}</div></div>
                            </div>`).join('')}
                    </div></div>
                    ${c.glossary.length ? `<div class="card mb-3"><div class="card-header"><i class="bi bi-stars me-2"></i>Yeni kelimeler</div><div class="card-body py-2">
                        ${c.glossary.map(g => `<div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                            <div><b lang="en">${esc(g.lemma)}</b> <span class="small text-body-secondary">${esc(posNames[g.pos] || g.pos)}</span> — ${esc(g.meaningTr)}</div>
                            <button class="btn btn-sm btn-outline-primary add-gloss" data-word="${esc(g.word)}"><i class="bi bi-plus-lg"></i></button>
                        </div>`).join('')}
                    </div></div>` : ''}
                    ${c.questions.length ? `<div class="card mb-3"><div class="card-header"><i class="bi bi-patch-question me-2"></i>Anladın mı?</div><div class="card-body">
                        ${c.questions.map((q, qi) => `<div class="mb-3 q" data-correct="${q.correctIndex}">
                            <div class="fw-semibold mb-1">${qi + 1}. ${esc(q.questionTr)}</div>
                            ${q.options.map((o, oi) => `<button class="btn btn-sm btn-outline-secondary me-1 mb-1 opt" data-i="${oi}">${esc(o)}</button>`).join('')}
                        </div>`).join('')}
                        <div id="qResult" class="fw-semibold"></div>
                    </div></div>` : ''}`);

                const sentenceOf = el => $(el).closest('.rs').text().trim();

                $('#readView')
                    .on('change', '#showTr', e => $('.reading-tr').toggleClass('d-none', !e.target.checked))
                    .on('click', '.say-p', function () { App.audio.speakAi(c.paragraphs[$(this).data('i')].en); })
                    .on('click', '.rw', function () {
                        $('.rw.active').removeClass('active'); $(this).addClass('active');
                        lookup($(this).text(), sentenceOf(this));
                    })
                    .on('click', '.add-gloss', function () {
                        const g = gloss[String($(this).data('word')).toLowerCase()];
                        const el = $('.rw').filter((_, x) => $(x).text().toLowerCase() === g.word.toLowerCase()).first();
                        addWord({ lemma: g.lemma, pos: g.pos, meaningTr: g.meaningTr, ipa: null }, el.length ? sentenceOf(el) : g.word, this);
                    })
                    .on('click', '.opt', function () {
                        const $q = $(this).closest('.q'); if ($q.hasClass('done')) return;
                        const ok = $(this).data('i') === $q.data('correct');
                        $q.addClass('done').data('ok', ok).find('.opt').prop('disabled', true);
                        $(this).removeClass('btn-outline-secondary').addClass(ok ? 'btn-success' : 'btn-danger');
                        if (!ok) $q.find(`.opt[data-i="${$q.data('correct')}"]`).removeClass('btn-outline-secondary').addClass('btn-success');
                        if ($('.q').length === $('.q.done').length) {
                            const right = $('.q.done').filter((_, q) => $(q).data('ok')).length;
                            $('#qResult').text(`${right} / ${$('.q').length} doğru ${right === $('.q').length ? '🎉' : ''}`);
                            api.post(`reading/${id}/read`).catch(() => { });
                        }
                    })
                    .on('click', '#delRead', async function () {
                        if (!await App.confirm('Metin silinsin mi?', 'Kartlarına eklediğin kelimeler kalır.', 'Sil')) return;
                        try { await api.del('reading/' + id); location.href = '/Practice/Reading'; } catch (e) { App.showError(e); }
                    });

                async function lookup(word, sentence) {
                    const g = gloss[word.toLowerCase()];
                    const $p = $('#lookupPop').removeClass('d-none')
                        .html('<div class="card shadow"><div class="card-body"><div class="skeleton" style="height:48px"></div></div></div>');
                    let d;
                    if (g) d = { lemma: g.lemma, pos: g.pos, meaningTr: g.meaningTr, ipa: null, fromDictionary: false, alreadyInCards: false };
                    else {
                        try { d = await api.post('reading/lookup', { word, sentence }); }
                        catch (e) { $p.addClass('d-none'); return App.showError(e); }
                    }
                    $p.html(`<div class="card shadow"><div class="card-body py-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div><span class="fs-5 fw-bold" lang="en">${esc(d.lemma)}</span> ${d.ipa ? `<span class="text-body-secondary small">/${esc(d.ipa.replace(/^\/|\/$/g, ''))}/</span>` : ''}
                                <span class="small text-body-secondary">· ${esc(posNames[d.pos] || d.pos)}</span></div>
                            <button class="btn-close" id="closePop"></button>
                        </div>
                        <div class="fs-6 text-primary fw-semibold my-1">${esc(d.meaningTr)}</div>
                        <div class="d-flex gap-2 mt-2">
                            <button class="btn btn-sm btn-outline-secondary" id="sayWord"><i class="bi bi-volume-up"></i></button>
                            <button class="btn btn-sm btn-primary ms-auto" id="addPop" ${d.alreadyInCards ? 'disabled' : ''}>
                                <i class="bi ${d.alreadyInCards ? 'bi-check2' : 'bi-plus-lg'} me-1"></i>${d.alreadyInCards ? 'Kartlarında var' : 'Kartlarıma ekle'}</button>
                        </div></div></div>`);
                    $p.off('click').on('click', '#closePop', () => { $p.addClass('d-none'); $('.rw.active').removeClass('active'); })
                        .on('click', '#sayWord', () => App.audio.speakAi(d.lemma))
                        .on('click', '#addPop', function () { addWord(d, sentence, this); });
                }

                async function addWord(d, sentence, btn) {
                    App.busy(btn, true, '');
                    try {
                        const res = await api.post('reading/add-word', {
                            lemma: d.lemma, pos: d.pos, meaningTr: d.meaningTr, ipa: d.ipa || null,
                            sentence: sentence.slice(0, 500), sourceNote: ('Okuma: ' + r.title).slice(0, 200)
                        });
                        App.toast(res.newWordCards ? `"${d.lemma}" kartlarına eklendi` : 'Bu kelime zaten kartlarında; cümlesi eklendi', res.newWordCards ? 'success' : 'info');
                        $(btn).html('<i class="bi bi-check2"></i>').prop('disabled', true);
                    } catch (e) { App.showError(e); App.busy(btn, false); }
                }
            }
        })();
    </script>
}
