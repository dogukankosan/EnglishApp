@{
    ViewData["Title"] = "AI Konuşma";
}
<div class="chat-wrap" id="talkApp"
     data-conversation-id="@(ViewBag.ConversationId)"
     data-scenario-id="@(ViewBag.ScenarioId)"
     data-mode="@(ViewBag.Mode)">

    <div class="d-flex align-items-center gap-2 mb-2">
        <a href="/Practice" class="btn btn-icon" title="Geri"><i class="bi bi-arrow-left"></i></a>
        <div class="flex-grow-1 min-w-0">
            <div class="fw-bold text-truncate" id="chatTitle">Hazırlanıyor…</div>
            <div class="small text-body-secondary text-truncate" id="chatRoles"></div>
        </div>
        <span class="badge bg-primary-soft text-primary d-none d-sm-inline" id="quotaBadge"></span>
        <button class="btn btn-sm btn-outline-primary" id="finishBtn" disabled><i class="bi bi-flag me-1"></i>Bitir</button>
    </div>

    <div class="d-flex flex-wrap gap-3 small mb-2 px-1">
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" id="autoSpeak" checked />
            <label class="form-check-label" for="autoSpeak">AI'ı sesli oku</label>
        </div>
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" id="naturalVoice" checked />
            <label class="form-check-label" for="naturalVoice" title="Gemini'nin gerçekçi sesi. Kota dolarsa otomatik olarak tarayıcı sesine geçer">Doğal ses</label>
        </div>
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" id="handsFree" />
            <label class="form-check-label" for="handsFree" title="AI konuşunca mikrofon otomatik açılır, sen konuşunca mesaj otomatik gider">Eller serbest</label>
        </div>
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" id="showTr" />
            <label class="form-check-label" for="showTr">Çevirileri hep göster</label>
        </div>
        <select class="form-select form-select-sm w-auto py-0 ms-sm-auto" id="sttMethod" title="Mikrofon sesini yazıya çevirme yöntemi">
            <option value="auto">🎤 Ses tanıma: Otomatik</option>
            <option value="browser">🎤 Tarayıcı (canlı yazı, Chrome/Edge)</option>
            <option value="whisper">🎤 Sunucu: Whisper (her tarayıcı, daha doğru)</option>
        </select>
    </div>

    <div class="card chat-card">
        <div class="chat-scroll" id="chatScroll">
            <div class="chat-messages" id="messages"></div>
            <div class="chat-typing d-none" id="typing"><span></span><span></span><span></span></div>
        </div>
        <div class="chat-suggestions" id="suggestions"></div>
        <div class="chat-input" id="inputBar">
            <button class="btn mic-btn" id="micBtn" title="Konuş (M)"><i class="bi bi-mic-fill"></i></button>
            <textarea class="form-control" id="msgInput" rows="1" maxlength="500" placeholder="İngilizce yaz veya mikrofona bas…"></textarea>
            <button class="btn btn-primary send-btn" id="sendBtn" title="Gönder (Enter)"><i class="bi bi-send-fill"></i></button>
        </div>
    </div>

    <div id="summary" class="mt-3"></div>
</div>

@section Scripts {
    <script src="~/js/pages/talk.js" asp-append-version="true"></script>
}
