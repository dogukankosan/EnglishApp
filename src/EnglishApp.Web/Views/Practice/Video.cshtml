@{
    ViewData["Title"] = "YouTube Sahneleri";
}
<div style="max-width:1100px" class="mx-auto" id="videoApp" data-video-id="@(ViewBag.VideoId)">
    <div class="mb-3"><a href="/Practice" class="small text-decoration-none" id="backLink"><i class="bi bi-arrow-left me-1"></i>AI Pratik</a></div>

    <div id="createView" class="d-none" style="max-width:820px">
        <h1 class="h3 page-title">YouTube sahneleri</h1>
        <p class="page-subtitle">Sevdiğin bir videoyu cümle cümle izle: her cümleyi tekrar tekrar dinle, önce metni gizleyip anlamaya çalış, beğendiğin cümleyi kartlarına ekle.</p>

        <div class="card mb-4">
            <div class="card-body">
                <form id="videoForm" class="row g-2">
                    <div class="col-md-7"><label class="form-label small fw-semibold">YouTube linki *</label><input class="form-control" id="vUrl" maxlength="300" placeholder="https://www.youtube.com/watch?v=..." required /></div>
                    <div class="col-md-5"><label class="form-label small fw-semibold">Başlık</label><input class="form-control" id="vTitle" maxlength="200" placeholder="Ör: Friends - Central Perk" /></div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Transkript (zamanlarıyla) *</label>
                        <textarea class="form-control font-monospace small" id="vTranscript" rows="8" lang="en" spellcheck="false" placeholder="0:01&#10;Hey, how's it going?&#10;0:04&#10;Pretty good, thanks."></textarea>
                        <div class="form-text">
                            <b>Transkript nasıl alınır?</b> Videonun altında açıklamayı genişlet → <b>Transkripti göster</b> → sağda açılan paneldeki metni baştan sona seçip kopyala, buraya yapıştır.
                            (YouTube altyazıların otomatik çekilmesine izin vermiyor, o yüzden bu adım elle.) .srt / .vtt dosyasının içeriği de olur.
                        </div>
                    </div>
                    <div class="col-12 d-flex justify-content-end"><button class="btn btn-primary" id="createBtn" type="submit"><i class="bi bi-plus-lg me-1"></i>Ekle</button></div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><i class="bi bi-youtube me-2"></i>Videolarım</div>
            <div class="list-group list-group-flush" id="videoList"><div class="p-3"><div class="skeleton" style="height:60px"></div></div></div>
        </div>
    </div>

    <div id="watchView" class="d-none"></div>
</div>

@section Scripts {
    <script>
        (async function () {
            const { api, esc, fmt } = App;
            const videoId = $('#videoApp').data('video-id') || null;

            if (videoId) return watch(videoId);
            $('#createView').removeClass('d-none');
            loadList();

            async function loadList() {
                try {
                    const list = await api.get('videos');
                    $('#videoList').html(list.length ? list.map(v => `
                        <a href="/Practice/Video/${v.id}" class="list-group-item list-group-item-action d-flex gap-3 align-items-center py-2">
                            <img src="https://i.ytimg.com/vi/${encodeURIComponent(v.youtubeId)}/mqdefault.jpg" alt="" width="96" height="54" style="object-fit:cover;border-radius:8px" loading="lazy" />
                            <div class="min-w-0"><div class="fw-semibold text-truncate">${esc(v.title)}</div>
                                <div class="small text-body-secondary">${v.segmentCount} sahne · ${fmt.date(v.createdAt)}</div></div>
                        </a>`).join('') : '<div class="empty-state py-4"><i class="bi bi-youtube"></i>Henüz video yok.</div>');
                } catch (e) { App.showError(e); }
            }

            $('#videoForm').on('submit', async function (e) {
                e.preventDefault();
                App.busy('#createBtn', true, 'Ekleniyor');
                try {
                    const v = await api.post('videos', { url: $('#vUrl').val().trim(), title: $('#vTitle').val().trim() || null, transcript: $('#vTranscript').val() });
                    location.href = '/Practice/Video/' + v.id;
                } catch (err) { App.showError(err); App.busy('#createBtn', false); }
            });

            // ---------- İzleme ----------
            async function watch(id) {
                $('#backLink').attr('href', '/Practice/Video').html('<i class="bi bi-arrow-left me-1"></i>Videolarım');
                $('#watchView').removeClass('d-none').html('<div class="skeleton" style="height:360px"></div>');
                let v;
                try { v = await api.get('videos/' + id); } catch (e) { return App.showError(e); }
                document.title = v.title + ' · EnglishApp';
                const segs = v.segments;
                const tFmt = s => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

                $('#watchView').html(`
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <h1 class="h4 page-title mb-0">${esc(v.title)}</h1>
                        <button class="btn btn-outline-danger btn-sm" id="delVideo"><i class="bi bi-trash"></i></button>
                    </div>
                    <div class="row g-3">
                        <div class="col-lg-7">
                            <div class="video-wrap mb-2"><div id="player"></div></div>
                            <div class="card"><div class="card-body py-2 d-flex flex-wrap gap-2 align-items-center">
                                <button class="btn btn-sm btn-outline-secondary" id="prevSeg" title="Önceki sahne"><i class="bi bi-skip-backward"></i></button>
                                <button class="btn btn-sm btn-primary" id="replaySeg" title="Sahneyi tekrar oynat (R)"><i class="bi bi-arrow-repeat me-1"></i>Tekrar</button>
                                <button class="btn btn-sm btn-outline-secondary" id="nextSeg" title="Sonraki sahne"><i class="bi bi-skip-forward"></i></button>
                                <select class="form-select form-select-sm w-auto" id="speed" title="Hız"><option value="0.75">0,75x</option><option value="1" selected>1x</option></select>
                                <div class="form-check form-switch mb-0 ms-auto"><input class="form-check-input" type="checkbox" id="loopSeg"><label class="form-check-label small" for="loopSeg">Sahneyi döngüye al</label></div>
                                <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" id="hideText"><label class="form-check-label small" for="hideText">Metni gizle</label></div>
                            </div></div>
                            <div class="card mt-2"><div class="card-body py-2" id="curSeg"><span class="small text-body-secondary">Bir sahneye tıkla.</span></div></div>
                        </div>
                        <div class="col-lg-5">
                            <div class="card"><div class="card-header d-flex justify-content-between"><span>Sahneler</span><span class="small text-body-secondary">${segs.length}</span></div>
                                <div class="seg-list" id="segList">${segs.map((s, i) => `
                                    <div class="seg" data-i="${i}"><span class="seg-time">${tFmt(s.start)}</span><span class="seg-text flex-grow-1" lang="en">${esc(s.text)}</span></div>`).join('')}
                                </div></div>
                        </div>
                    </div>`);

                let player = null, cur = -1, endAt = null, timer = 0;

                window.onYouTubeIframeAPIReady = () => {
                    player = new YT.Player('player', {
                        videoId: v.youtubeId,
                        playerVars: { rel: 0, modestbranding: 1, cc_load_policy: 0, playsinline: 1 },
                        events: { onStateChange: e => { if (e.data === YT.PlayerState.PLAYING) startWatch(); } }
                    });
                };
                if (window.YT && window.YT.Player) window.onYouTubeIframeAPIReady();
                else $('<script>').attr('src', 'https://www.youtube.com/iframe_api').appendTo('body');

                function startWatch() {
                    clearInterval(timer);
                    timer = setInterval(() => {
                        if (!player?.getCurrentTime) return;
                        const t = player.getCurrentTime();
                        if (endAt != null && t >= endAt) {
                            if ($('#loopSeg').is(':checked')) player.seekTo(segs[cur].start, true);
                            else { player.pauseVideo(); endAt = null; }
                            return;
                        }
                        // Serbest izlerken aktif sahneyi takip et
                        if (endAt == null) {
                            let i = segs.findIndex((s, k) => t >= s.start && (k === segs.length - 1 || t < segs[k + 1].start));
                            if (i !== -1 && i !== cur) mark(i, false);
                        }
                    }, 150);
                }

                function mark(i, scroll = true) {
                    cur = i;
                    $('.seg').removeClass('active');
                    const $s = $(`.seg[data-i="${i}"]`).addClass('active');
                    if (scroll && $s.length) $s[0].scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                    const s = segs[i];
                    const hidden = $('#hideText').is(':checked');
                    $('#curSeg').html(`
                        <div class="fs-5 mb-2 ${hidden ? 'blur-text' : ''}" id="curText" lang="en" title="${hidden ? 'Göstermek için tıkla' : ''}">${esc(s.text)}</div>
                        <div class="d-flex flex-wrap gap-2">
                            ${App.shadow.button(s.text, 'Sesli tekrar et')}
                            <a class="btn btn-sm btn-outline-primary" href="/Practice/Capture?text=${encodeURIComponent(s.text)}&source=${encodeURIComponent(v.title + ' ' + tFmt(s.start))}" target="_blank" rel="noopener"><i class="bi bi-bookmark-plus me-1"></i>Yakala (AI açıklasın)</a>
                        </div>`);
                }

                function playSeg(i) {
                    if (!player?.seekTo || i < 0 || i >= segs.length) return;
                    mark(i);
                    endAt = i + 1 < segs.length ? segs[i + 1].start : null;
                    player.seekTo(segs[i].start, true);
                    player.playVideo();
                }

                $('#watchView')
                    .on('click', '.seg', function () { playSeg(parseInt($(this).data('i'), 10)); })
                    .on('click', '#replaySeg', () => playSeg(Math.max(cur, 0)))
                    .on('click', '#prevSeg', () => playSeg(cur - 1))
                    .on('click', '#nextSeg', () => playSeg(cur + 1))
                    .on('change', '#speed', e => player?.setPlaybackRate(parseFloat(e.target.value)))
                    .on('change', '#hideText', e => { $('#segList').toggleClass('hide-all', e.target.checked); $('.seg').toggleClass('hidden-text', e.target.checked); if (cur >= 0) mark(cur, false); })
                    .on('click', '.seg.hidden-text .seg-text, #curText.blur-text', function (e) { e.stopPropagation(); $(this).closest('.seg').removeClass('hidden-text'); $(this).removeClass('blur-text'); })
                    .on('click', '#delVideo', async function () {
                        if (!await App.confirm('Video silinsin mi?', '', 'Sil')) return;
                        try { await api.del('videos/' + id); location.href = '/Practice/Video'; } catch (e) { App.showError(e); }
                    });
                $(document).on('keydown', e => {
                    if ($(e.target).is('input, textarea, select')) return;
                    if (e.key === 'r' || e.key === 'R') playSeg(Math.max(cur, 0));
                    if (e.key === 'ArrowRight') playSeg(cur + 1);
                    if (e.key === 'ArrowLeft') playSeg(cur - 1);
                });
            }
        })();
    </script>
}
