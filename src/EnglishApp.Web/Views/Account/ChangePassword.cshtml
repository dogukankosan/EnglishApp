@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Şifre Değiştir";
    Layout = "_AuthLayout";
}
<div class="card">
    <div class="card-body p-4">
        <h2 class="h5 fw-bold mb-1">Yeni şifreni belirle</h2>
        <p class="small text-body-secondary mb-3">Güvenliğin için ilk girişte (veya şifren sıfırlandığında) şifreni değiştirmen gerekiyor.</p>
        <form asp-action="ChangePassword" method="post" novalidate>
            <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>
            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label small fw-semibold">Mevcut (geçici) şifre</label>
                <input asp-for="CurrentPassword" class="form-control" type="password" autocomplete="current-password" autofocus />
            </div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label small fw-semibold">Yeni şifre</label>
                <input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" />
                <div class="form-text">En az 8 karakter, en az 1 harf ve 1 rakam.</div>
            </div>
            <div class="mb-4">
                <label asp-for="NewPasswordConfirm" class="form-label small fw-semibold">Yeni şifre (tekrar)</label>
                <input asp-for="NewPasswordConfirm" class="form-control" type="password" autocomplete="new-password" />
            </div>
            <button class="btn btn-primary btn-lg w-100" type="submit">Şifremi değiştir</button>
        </form>
        <form asp-action="Logout" method="post" class="text-center mt-3">
            <button type="submit" class="btn btn-link btn-sm text-body-secondary">Çıkış yap</button>
        </form>
    </div>
</div>
