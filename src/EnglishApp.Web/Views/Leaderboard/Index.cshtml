@{
    ViewData["Title"] = "Sıralama";
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h1 class="h3 page-title">Sıralama</h1>
        <p class="page-subtitle mb-0">Herkes ne kadar çalışıyor? Arkadaşlarınla yarış, motivasyonunu koru.</p>
    </div>
    <div class="btn-group" role="group" id="periodTabs">
        <button class="btn btn-outline-primary" data-period="today">Bugün</button>
        <button class="btn btn-outline-primary active" data-period="week">Bu hafta</button>
        <button class="btn btn-outline-primary" data-period="month">Bu ay</button>
    </div>
</div>

<div id="myCard" class="mb-3"></div>
<div class="row g-3 mb-3" id="podium"></div>

<div class="card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span id="tableTitle">Tüm kullanıcılar</span>
        <div class="d-flex align-items-center gap-2">
            <label class="small text-body-secondary" for="sortBy">Sırala:</label>
            <select class="form-select form-select-sm w-auto" id="sortBy">
                <option value="points">Puan</option>
                <option value="minutes">Çalışma süresi</option>
                <option value="newWords">Yeni kelime</option>
                <option value="streak">Seri</option>
                <option value="vocabulary">Kelime dağarcığı</option>
            </select>
        </div>
    </div>
    <div class="table-responsive d-none d-md-block">
        <table class="table table-hover align-middle mb-0 lb-table">
            <thead>
                <tr>
                    <th style="width:56px">#</th><th>Kullanıcı</th><th>Seviye</th>
                    <th class="text-center">Seri</th><th class="text-center">Bugün</th>
                    <th class="text-end">Kart</th><th class="text-end">Yeni kelime</th><th class="text-end">Süre</th>
                    <th class="text-end">Doğruluk</th><th class="text-end">Kelime dağarcığı</th><th class="text-end">Puan</th>
                </tr>
            </thead>
            <tbody id="lbTable"><tr><td colspan="11"><div class="skeleton" style="height:80px"></div></td></tr></tbody>
        </table>
    </div>
    <div class="list-group list-group-flush d-md-none" id="lbList"></div>
</div>
<p class="small text-body-secondary mt-2"><i class="bi bi-info-circle me-1"></i>Puan = çalışılan kart + 2 × yeni kelime. Seri, art arda çalışılan gün sayısıdır (dinlenme günü açıksa haftada 1 gün atlanabilir). Sadece özet sayılar paylaşılır; kelimelerin, sohbet ve yazıların başkasına görünmez.</p>

@section Scripts {
    <script>
        (function () {
            const { api, esc, fmt } = App;
            let data = null;

            const initials = n => (n || '').split(' ').filter(Boolean).slice(0, 2).map(p => p[0].toLocaleUpperCase('tr-TR')).join('');
            const avatar = (r, size = 'sm') => r.profileImage
                ? `<img src="/bff/files/profile/${encodeURIComponent(r.profileImage)}" class="avatar avatar-${size}" alt="" loading="lazy" />`
                : `<span class="avatar avatar-${size} avatar-initials">${esc(initials(r.fullName))}</span>`;
            const medal = rank => rank === 1 ? '🥇' : rank === 2 ? '🥈' : rank === 3 ? '🥉' : rank;
            const name = r => `${esc(r.fullName)}${r.isMe ? ' <span class="badge bg-primary-soft text-primary">Sen</span>' : ''}${r.isAdmin ? ' <i class="bi bi-shield-lock text-body-secondary small" title="Yönetici"></i>' : ''}`;
            const today = r => r.studiedToday ? '<i class="bi bi-check-circle-fill text-success" title="Bugün çalıştı"></i>'
                : `<span class="text-body-secondary small" title="Son çalışma">${r.lastStudyDate ? fmt.dayMonth(r.lastStudyDate) : '—'}</span>`;
            const level = r => `<span class="level-badge">${esc(r.estimatedLevel)}</span>${r.targetLevel ? ` <span class="small text-body-secondary">→ ${esc(r.targetLevel)}</span>` : ''}`;

            async function load(period) {
                $('#lbTable').html('<tr><td colspan="11"><div class="skeleton" style="height:80px"></div></td></tr>');
                try { data = await api.get('leaderboard', { period }); } catch (e) { return App.showError(e); }
                render();
            }

            function sorted() {
                const key = $('#sortBy').val();
                if (key === 'points') return data.items;
                return [...data.items].sort((a, b) => (b[key] - a[key]) || (b.points - a.points));
            }

            function render() {
                const items = sorted();
                const me = data.items.find(r => r.isMe);
                $('#tableTitle').text(`${data.periodLabel} · ${data.items.length} kullanıcı`);

                // Benim durumum
                if (me) {
                    const above = data.items.filter(r => r.points > me.points).sort((a, b) => a.points - b.points)[0];
                    const tip = me.rank === 1
                        ? (me.points > 0 ? 'Zirvedesin! 🏆 Böyle devam.' : 'Henüz kimse çalışmadı, ilk sen başla!')
                        : `${esc(above.fullName)} ile arandaki fark ${above.points - me.points} puan.`;
                    $('#myCard').html(`
                        <div class="card hero-card"><div class="card-body p-3 p-md-4 d-flex flex-wrap align-items-center gap-3">
                            <div class="display-6 fw-bold">${medal(me.rank)}</div>
                            <div class="flex-grow-1">
                                <div class="text-soft small fw-semibold text-uppercase">${esc(data.periodLabel)} sıralaman</div>
                                <div class="h4 fw-bold mb-0">${me.rank}. sıradasın · ${fmt.number(me.points)} puan</div>
                                <div class="text-soft small">${tip}</div>
                            </div>
                            <a href="/Study/Session" class="btn btn-light"><i class="bi bi-play-fill me-1"></i>Puan topla</a>
                        </div></div>`);
                }

                // İlk 3 (puana göre)
                const top = data.items.filter(r => r.points > 0).slice(0, 3);
                $('#podium').html(top.map(r => `
                    <div class="col-md-4">
                        <div class="card h-100 text-center ${r.isMe ? 'border-primary' : ''}"><div class="card-body">
                            <div class="fs-2">${medal(r.rank)}</div>
                            <div class="my-2">${avatar(r, 'md')}</div>
                            <div class="fw-bold">${name(r)}</div>
                            <div class="h4 fw-bold text-primary mb-1">${fmt.number(r.points)} <span class="small text-body-secondary fw-normal">puan</span></div>
                            <div class="small text-body-secondary">${r.reviews} kart · ${r.newWords} yeni kelime · ${r.minutes} dk</div>
                        </div></div>
                    </div>`).join(''));

                // Tablo (masaüstü)
                $('#lbTable').html(items.map(r => `
                    <tr class="${r.isMe ? 'table-primary' : ''}">
                        <td class="fw-bold">${medal(r.rank)}</td>
                        <td><div class="d-flex align-items-center gap-2">${avatar(r)}<div>${name(r)}</div></div></td>
                        <td>${level(r)}</td>
                        <td class="text-center">${r.streak > 0 ? `🔥 ${r.streak}` : '<span class="text-body-secondary">0</span>'}</td>
                        <td class="text-center">${today(r)}</td>
                        <td class="text-end">${fmt.number(r.reviews)}</td>
                        <td class="text-end">${fmt.number(r.newWords)}</td>
                        <td class="text-end">${r.minutes} dk</td>
                        <td class="text-end">${r.accuracyPercent == null ? '—' : '%' + r.accuracyPercent}</td>
                        <td class="text-end">${fmt.number(r.vocabulary)}</td>
                        <td class="text-end fw-bold">${fmt.number(r.points)}</td>
                    </tr>`).join('') || '<tr><td colspan="11" class="text-center text-body-secondary py-4">Kullanıcı yok.</td></tr>');

                // Liste (mobil)
                $('#lbList').html(items.map(r => `
                    <div class="list-group-item py-3 ${r.isMe ? 'bg-primary-soft' : ''}">
                        <div class="d-flex align-items-center gap-2">
                            <div class="fw-bold text-center" style="width:32px">${medal(r.rank)}</div>
                            ${avatar(r)}
                            <div class="flex-grow-1 min-w-0">
                                <div class="fw-semibold text-truncate">${name(r)}</div>
                                <div class="small text-body-secondary">${level(r)} · ${r.streak > 0 ? '🔥 ' + r.streak : 'seri yok'} · ${r.studiedToday ? 'bugün çalıştı ✓' : 'bugün çalışmadı'}</div>
                            </div>
                            <div class="text-end"><div class="fw-bold">${fmt.number(r.points)}</div><div class="small text-body-secondary">puan</div></div>
                        </div>
                        <div class="small text-body-secondary mt-1 ps-5">${r.reviews} kart · ${r.newWords} yeni · ${r.minutes} dk · ${r.accuracyPercent == null ? '—' : '%' + r.accuracyPercent} doğru · ${fmt.number(r.vocabulary)} kelime</div>
                    </div>`).join(''));
            }

            $('#periodTabs').on('click', 'button', function () {
                $('#periodTabs button').removeClass('active'); $(this).addClass('active');
                load($(this).data('period'));
            });
            $('#sortBy').on('change', () => data && render());
            load('week');
        })();
    </script>
}
