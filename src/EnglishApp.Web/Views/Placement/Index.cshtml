@{
    ViewData["Title"] = "Seviye Testi";
}
<div style="max-width:860px" class="mx-auto">
    <h1 class="h3 page-title">Seviye testi</h1>
    <p class="page-subtitle">
        <b>Kesin bildiğin</b> kelimelere dokun (yeşil olur). Emin değilsen işaretleme, onları uygulama sana öğretecek.
        Bildiklerin tekrar sorulmaz.
    </p>

    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="small text-body-secondary">Tur <b id="round">1</b> · Bu turda <b id="knownCount">0</b> kelime işaretledin · Toplam <b id="totalKnown">0</b></span>
                <button class="btn btn-sm btn-link" id="selectAll">Hepsini biliyorum</button>
            </div>
            <div class="row g-2" id="chips"></div>
        </div>
    </div>

    <div class="d-flex gap-2 justify-content-end">
        <button class="btn btn-outline-secondary" id="finishBtn">Testi bitir</button>
        <button class="btn btn-primary" id="nextBtn">Kaydet ve devam et <i class="bi bi-arrow-right ms-1"></i></button>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const { api, esc } = App;
            let words = [], round = 1, totalKnown = 0;

            async function loadRound() {
                $('#chips').html('<div class="col-12"><div class="skeleton" style="height:160px"></div></div>');
                try {
                    words = await api.get('placement/words', { count: 30 });
                } catch (e) { App.showError(e); return; }
                if (!words.length) return finish(true);
                $('#round').text(round);
                $('#chips').html(words.map(w => `
                    <div class="col-6 col-md-4 col-lg-3">
                        <button type="button" class="word-chip" data-id="${w.wordId}">
                            <div class="w">${esc(w.lemma)}</div>
                            <div class="m">${esc(w.meaningTr)}</div>
                        </button>
                    </div>`).join(''));
                count();
            }

            function count() { $('#knownCount').text($('.word-chip.known').length); $('#totalKnown').text(totalKnown); }
            function selected() { return $('.word-chip.known').map((_, el) => $(el).data('id')).get(); }

            async function save(finishFlag) {
                const ids = selected();
                const r = await api.post('placement/submit', { knownWordIds: ids, finish: finishFlag });
                totalKnown += r;
                return ids.length;
            }

            async function finish(noMore) {
                try {
                    if (!noMore) await save(true);
                    else await api.post('placement/submit', { knownWordIds: [], finish: true });
                    await Swal.fire({
                        icon: 'success', title: 'Test tamamlandı',
                        text: `${totalKnown} kelimeyi "biliyorum" olarak işaretledin. Şimdi bilmediklerinle çalışmaya başlayabilirsin!`,
                        confirmButtonText: 'Çalışmaya başla', confirmButtonColor: '#4f46e5'
                    });
                    location.href = '/Study/Session';
                } catch (e) { App.showError(e); }
            }

            $('#chips').on('click', '.word-chip', function () { $(this).toggleClass('known'); count(); });
            $('#selectAll').on('click', () => { $('.word-chip').addClass('known'); count(); });
            $('#nextBtn').on('click', async function () {
                App.busy(this, true, 'Kaydediliyor');
                try {
                    const n = await save(false);
                    // Hiçbirini bilmiyorsan daha zor kelimelere geçmenin anlamı yok
                    if (n < words.length * 0.3) { App.busy(this, false); return finish(true); }
                    round++; await loadRound();
                } catch (e) { App.showError(e); }
                App.busy(this, false);
            });
            $('#finishBtn').on('click', () => finish(false));
            loadRound();
        })();
    </script>
}
